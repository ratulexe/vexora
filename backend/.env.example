# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Add these when each integration is built
# Enables AI explanations (Claude). Without it, reports still work using fixed rules.
ANTHROPIC_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# Free key from https://auth.abuse.ch/ (optional; OpenPhish works without a key)
URLHAUS_AUTH_KEY=

# On-chain threat registry. Leave the private key empty to make the registry read-only.
REGISTRY_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
REGISTRY_CONTRACT_ADDRESS=
# Testnet-only wallet that pays for registrations. Never use a wallet holding real funds.
REGISTRY_PRIVATE_KEY=
REGISTRY_EXPLORER_URL=https://sepolia.etherscan.io
