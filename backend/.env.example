# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Add these when each integration is built
# Enables AI explanations (Claude). Without it, reports still work using fixed rules.
ANTHROPIC_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# Free key from https://auth.abuse.ch/ (optional; OpenPhish works without a key)
URLHAUS_AUTH_KEY=
